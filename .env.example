NETCONFIG_ENV=development
NETCONFIG_LOG_LEVEL=INFO

# Local API: sqlite:///artifacts/api.sqlite3; Compose sets its own PostgreSQL URL.
NETCONFIG_DATABASE_URL=
# Generate a token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NETCONFIG_API_TOKEN=
# Optional distinct service keys: read-only, analysis, engineer workflows.
# NETCONFIG_API_TOKEN retains administrator permissions. Blank roles are disabled.
# All roles can read all saved devices; this is not individual identity or tenant isolation.
NETCONFIG_READER_TOKEN=
NETCONFIG_ANALYST_TOKEN=
NETCONFIG_ENGINEER_TOKEN=
# Generate once, retain securely across restarts; changing this key loses access to old data.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NETCONFIG_ENCRYPTION_KEY=
# Compose development database: use hexadecimal characters to avoid URL escaping.
# python -c "import secrets; print(secrets.token_hex(32))"
NETCONFIG_POSTGRES_PASSWORD=

# Optional local language-model draft; blank means disabled. No model is downloaded.
# Set ALL three only after reviewing docs/local-model-explanations.md.
# Endpoint must be exactly http://127.0.0.1:<port>/v1/chat/completions, port 1024-65535.
# API and model must run in the same host/network namespace; Compose leaves this off.
NETCONFIG_LLM_ENDPOINT=
NETCONFIG_LLM_MODEL=
NETCONFIG_LLM_ALLOW_LOCAL_CONTEXT=
# Optional separate credential for the local model, never the API token/encryption key.
NETCONFIG_LLM_API_KEY=
# Separate model patch opt-in; explanations remain null-only. Blank/0 means disabled.
# Review docs/saved-model-patches.md before setting to 1. Each request also needs consent.
NETCONFIG_LLM_ALLOW_PATCH_DRAFT=

# Separate saved-candidate verification; disabled by default and in Compose.
# Fixed loopback engine must share the API network namespace. Review docs first.
NETCONFIG_PATCH_ALLOW_ENGINE_UPLOAD=
# Optional immutable local Transformer registry + independent model identity pin.
# No path is accepted from HTTP. Foundation source is explicit and offline.
NETCONFIG_PATCH_MODEL_REGISTRY=
NETCONFIG_PATCH_MODEL_SHA256=
NETCONFIG_PATCH_FOUNDATION_SOURCE=

# Optional single-source config-model diagnostics on saved analyses; disabled in Compose.
# Review docs/configuration-model-inference.md. Registry/pin are required together.
# Requests need engineer/admin permission, retained original and explicit consent.
NETCONFIG_CONFIG_MODEL_REGISTRY=
NETCONFIG_CONFIG_MODEL_SHA256=
NETCONFIG_CONFIG_MODEL_FOUNDATION_SOURCE=

# Optional sealed-document semantic retrieval; all first four fields required together.
# Review docs/semantic-explanation-context.md; configured does not prove runtime health.
NETCONFIG_DOCUMENT_MODEL_ROOT=
NETCONFIG_DOCUMENT_INDEX_ROOT=
NETCONFIG_DOCUMENT_INDEX_SHA256_0_1=
NETCONFIG_DOCUMENT_INDEX_SHA256_0_2=
# Independent optional pins for expanded comparison and measured peer sources.
NETCONFIG_DOCUMENT_INDEX_SHA256_0_3=
NETCONFIG_DOCUMENT_INDEX_SHA256_0_4=
