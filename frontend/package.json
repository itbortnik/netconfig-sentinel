{
  "name": "netconfig-sentinel-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src tests/browser vite.config.ts playwright*.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:model-patches": "playwright test --config=playwright.model-patches.config.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "prettier": "3.9.9",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
